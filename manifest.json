{
  "manifest_version": 3,
  "name": "Patrimoine Bankin Exporter",
  "version": "1.0.0",
  "description": "Export prive des donnees Bankin vers l'application patrimoine.",
  "permissions": ["storage", "webRequest", "downloads"],
  "host_permissions": [
    "https://*.bankin.com/*",
    "https://sync.bankin.com/*",
    "http://localhost:3000/*",
    "https://ton-app.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
